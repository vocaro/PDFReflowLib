      "rect" : [
        255.06870000000004,
        447.584,
        243.54400000000004,
        9.0160000000000196
      ],
      "text" : "Requires uniform disclosure of terms and conditions regarding interest rates and fees associated"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        437.584,
        190.21359999999993,
        9.0160000000000196
      ],
