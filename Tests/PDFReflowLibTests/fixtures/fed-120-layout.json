      "rect" : [
        111.57270000000003,
        477.47199999999998,
        81.455999999999989,
        9.0160000000000196
      ],
      "text" : "Expedited Funds Availability Act/"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        467.47199999999998,
        34.960000000000008,
        9.0160000000000196
      ],
      "text" : "Regulation CC"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        477.47199999999998,
        223.43199999999996,
        9.0160000000000196
      ],
      "text" : "Limits hold periods on deposits made to depository institutions and requires appropriate"
    },
    {
