diff --git a/Tests/PDFReflowLibTests/OCRHeadingTests.swift b/Tests/PDFReflowLibTests/OCRHeadingTests.swift
new file mode 100644
index 0000000..1a45c37
--- /dev/null
+++ b/Tests/PDFReflowLibTests/OCRHeadingTests.swift
@@ -0,0 +1,56 @@
+import Foundation
+import Testing
+@testable import PDFReflowLib
+
+private func ocrHeadingBlocks(_ page: PageContent) -> [ReflowBlock] {
+    var warnings: [ConversionWarning] = []
+    return LayoutReconstructor.blocks(page: page, images: [], vocabulary: [], warnings: &warnings)
+}
+
+@Test func freshOCRBoxHeightsDoNotDeclareHeadings() {
+    let lines = [
+        TextLine(text: "WHAT IS IT MAX?", rect: CGRect(x: 40, y: 240, width: 140, height: 18), fontSize: 18),
+        TextLine(text: "Several smaller dialogue fragments establish the usual box height.",
+                 rect: CGRect(x: 40, y: 200, width: 250, height: 10), fontSize: 10),
+        TextLine(text: "Another ordinary line.", rect: CGRect(x: 40, y: 180, width: 160, height: 10), fontSize: 10),
+    ]
+    var page = PageContent(number: 1, bounds: CGRect(x: 0, y: 0, width: 400, height: 300), lines: lines, graphics: [])
+    page.recognized = true
+    let blocks = ocrHeadingBlocks(page)
+    #expect(!blocks.contains { if case .heading = $0.content { return true }; return false })
+    #expect(blocks.contains { if case let .paragraph(text) = $0.content { return text.text == lines[0].text }; return false })
+    // Identical geometry with actual native typography remains eligible for heading inference.
+    page.recognized = false
+    #expect(ocrHeadingBlocks(page).contains { if case .heading = $0.content { return true }; return false })
+}
+
+@Test func comicSourceOCRDialogueRemainsParagraphText() throws {
+    var page = try SourceLayoutFixture.load("cdc-13-ocr").content()
+    page.recognized = true
+    let blocks = ocrHeadingBlocks(page)
+    #expect(!blocks.contains { if case .heading = $0.content { return true }; return false })
+    // Source review identifies speech, not a title; this does not assert panel or balloon order.
+    #expect(blocks.contains { if case let .paragraph(text) = $0.content { return text.text.contains("AND SEE WHAT'S HAPPENING...") }; return false })
+    for line in page.lines {
+        #expect(blocks.map(\.text).joined(separator: " ").contains(line.text))
+    }
+}
+
+@Test func nativeSourceTitlesRemainHeadings() throws {
+    for name in ["fed-77", "flag-31"] {
+        let source = try SourceLayoutFixture.load(name)
+        #expect(ocrHeadingBlocks(source.content()).contains { if case .heading = $0.content { return true }; return false })
+    }
+}
+
+@Test func freshOCRConversionKeepsTextAndSourceReference() async throws {
+    let dir = try testPDFDirectory(); defer { try? FileManager.default.removeItem(at: dir) }
+    let source = Bundle.module.resourceURL!.appendingPathComponent("fixtures/scanned.pdf")
+    let result = try await PDFReflowLibPipeline.reconstruct(from: source, options: ConversionOptions(),
+        workspace: dir, progress: { _ in })
+    #expect(result.recognizedPageCount == 1)
+    #expect(result.document.blocks.contains { $0.text.contains("clear scanned paragraph") })
+    #expect(!result.document.blocks.contains { if case .heading = $0.content { return true }; return false })
+    #expect(result.document.assets.count == 1)
+    #expect(result.warnings.contains { $0.code == .ocrUsed })
+}
