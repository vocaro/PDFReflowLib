      ],
      "structure" : {
        "group" : 438,
        "headingLevel" : 0,
        "lineCount" : 4,
        "opensWithSplitMarker" : false,
        "order" : 5655
      },
      "text" : "The U.S. payment system has evolved significantly since the Federal Reserve was established in"
    },
    {
      "fontSize" : 10,
      "monospaced" : false,
      "rect" : [
        90,
        345.43610000000001,
        416.74299999999965,
