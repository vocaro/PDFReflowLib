+enum PageRetention: String, Sendable, CaseIterable {
+    /// Keep every extracted page in memory until reconstruction finishes.
+    case resident
+    /// Encode each page into the workspace after extraction and reload it during reconstruction.
+    case spill
+    /// Repeat deterministic native extraction during reconstruction; recognized pages spill.
+    case reextract
+
+    static let environmentVariable = "PDFREFLOW_PAGE_RETENTION"
+    /// Selected by the page-retention measurement: identical output on every corpus book with
+    /// the lowest peak footprint. `resident` remains the pre-change control.
+    static let `default` = PageRetention.spill
+
+    /// A misspelled selection must fail loudly rather than measure the default silently.
+    static func configured(environment: [String: String] = ProcessInfo.processInfo.environment) throws -> PageRetention {
+        guard let value = environment[environmentVariable], !value.isEmpty else { return .default }
+        guard let retention = PageRetention(rawValue: value) else {
+            throw ConversionError.invalidOptions(
+                "\(environmentVariable) must be one of \(allCases.map(\.rawValue).joined(separator: ", "))")
+        }
+        return retention
+    }
+}
