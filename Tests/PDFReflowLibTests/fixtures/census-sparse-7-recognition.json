    },
    {
      "fontSize" : 9.8999999999999648,
      "monospaced" : false,
      "rect" : [
        133.61725059301611,
        429.00000000246268,
        348.06469002695411,
        9.8999999999999648
      ],
      "text" : "easily identified via the assignment algorithm. The assignment algorithm has the",
      "wraps" : true
    },
    {
      "fontSize" : 11.550000000000047,
      "monospaced" : false,
      "rect" : [
        133.61725058573131,
        415.80000000303949,
        348.06469002695411,
        11.550000000000047
      ],
      "text" : "effect of drastically improving matching efficacy, particularly in re-identification",
      "wraps" : true
    },
    {
      "fontSize" : 11.549999999999958,
      "monospaced" : false,
      "rect" : [
        133.61725058198667,
        404.25000000469515,
        348.06469002695422,
        11.549999999999958
      ],
      "text" : "experiments of the type given in this paper. For instance, if a moderate number",
      "wraps" : true
    },
    {
      "fontSize" : 9.8999999999999648,
      "monospaced" : false,
      "rect" : [
        133.61725059176749,
        392.70000000235711,
        348.06469002695422,
        9.8999999999999648
      ],
      "text" : "of pairs associated with true re-identifications have probability greater than 0.5",
      "wraps" : true
    },
    {
      "fontSize" : 9.8999999999999648,
      "monospaced" : false,
      "rect" : [
        133.61725059729628,
        381.15000000253849,
        348.06469002695411,
        9.8999999999999648
      ],
      "text" : "when looked at in isolation, the assignment algorithm effectively sets their match",
