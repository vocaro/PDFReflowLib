        597.024,
        74.631999999999991,
        9.0159999999999627
      ],
      "text" : "Federal Trade Commission Act"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        597.024,
        212.06399999999996,
        9.0159999999999627
      ],
      "text" : "Prohibits unfair or deceptive acts or practices in any aspect of banking transactions."
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        577.13599999999997,
        125.98319999999995,
        9.0159999999999627
      ],
      "text" : "Gramm-Leach-Bliley Act (title V, subpart A), Disclo-"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        567.13599999999997,
        101.93599999999998,
        9.0159999999999627
      ],
      "text" : "sure of Nonpublic Personal Information*"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        577.13599999999997,
        233.54399999999998,
        9.0159999999999627
      ],
      "text" : "Describes the conditions under which a financial institution may disclose nonpublic personal"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        567.13599999999997,
        240.42239999999993,
        9.0159999999999627
      ],
      "text" : "information about consumers to nonaffiliated third parties, provides a method for consumers to"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        557.13599999999997,
        242.64559999999994,
        9.0159999999999627
      ],
      "text" : "opt out of information sharing with nonaffiliated third parties, and requires a financial institution"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        547.13599999999997,
        151.00799999999998,
        9.0159999999999627
      ],
      "text" : "to notify consumers about its privacy policies and practices."
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        527.24799999999993,
        53.376000000000005,
        9.0480000000000018
      ],
      "text" : "Depository accounts"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        507.35999999999996,
        71.903199999999998,
        9.0160000000000196
      ],
      "text" : "Electronic Fund Transfer Act/"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        111.57270000000003,
        497.35999999999996,
        34.823999999999984,
        9.0160000000000196
      ],
      "text" : "Regulation E*"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        507.35999999999996,
        241.77359999999999,
        9.0160000000000196
      ],
      "text" : "Requires disclosure of the terms and conditions of electronic fund transfers. Protects consumers"
    },
    {
      "fontSize" : 8,
      "monospaced" : false,
      "rect" : [
        255.06870000000004,
        497.35999999999996,
        231.42399999999998,
        9.0160000000000196
      ],
      "text" : "against unauthorized transfers and establishes procedures for resolving errors and disputes."
    },
    {
      "fontSize" : 8,
