      "monospaced" : false,
      "rect" : [
        133.61725056888017,
        476.85000000321435,
        346.41509433962261,
        9.8999999999999648
      ],
      "text" : "and has equivalent computational speed. It differs because it contains compres-",
      "wraps" : true
    },
    {
      "fontSize" : 9.8999999999999648,
      "monospaced" : false,
      "rect" : [
        133.61725058312672,
        465.30000000260526,
        348.06469002695422,
        9.8999999999999648
      ],
      "text" : "sion/decompression routines that can reduce storage requirements for the array",
      "wraps" : true
    },
    {
      "fontSize" : 11.550000000000047,
      "monospaced" : false,
      "rect" : [
        133.61725059014975,
        452.10000000285891,
        348.06469002695422,
        11.550000000000047
      ],
      "text" : "of weights wy by a factor of 500 in some matching situations. When a few",
      "wraps" : true
    },
    {
      "fontSize" : 11.549999999999958,
      "monospaced" : false,
      "rect" : [
        133.61725119622642,
        440.55000019250002,
        348.06469002695422,
        11.549999999999958
      ],
      "text" : "matching pairs in a set can be reasonably identified, many other pairs can be",
