    },
    {
      "fontSize" : 11.550000000000047,
      "monospaced" : false,
      "rect" : [
        133.61725027978434,
        306.90000003208331,
        346.41509433962273,
        11.550000000000047
      ],
      "text" : "based record linkage (DLD) for situations in which Euclidean distance is used.",
