        10.026488829729601
      ],
      "text" : "-"
    },
    {
      "fontSize" : 8.2499996562499991,
      "monospaced" : false,
      "rect" : [
        206.7355872335169,
        679.26782694217411,
        24.725829109757086,
        10.026488829729601
      ],
      "text" : "2020)"
    },
    {
      "fontSize" : 10.499999562499999,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        642.67383434692385,
        106.26635311223509,
        14.29907170920535
      ],
      "text" : "Project Introduction"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        622.86035858748539,
        354.22117695078379,
        10.937987814250505
      ],
      "text" : "Sustained human presence in cislunar space relies on propellant management"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        610.86035908748534,
        345.64305212820551,
        10.937987814250505
      ],
      "text" : "technologies that either do not exist or exist only at low-TRL. One such low-"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        598.86035958748539,
        349.53660676597406,
        10.937987814250505
      ],
      "text" : "TRL technology is propellant mass gauging in microgravity. NASA technology"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        586.86036008748533,
        349.74314964736811,
        10.937987814250505
      ],
      "text" : "roadmaps and Artemis architectures call for the ability to measure propellant"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        574.86036058748539,
        350.78904833378903,
        10.937987814250505
      ],
      "text" : "in both settled and unsettled states during propellant transfer operations and"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        562.86036108748533,
        328.40330687652829,
        10.937987814250505
      ],
      "text" : "during quiescent periods of microgravity. Target gauging resolutions are"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        550.86036158748539,
        343.30955634543454,
        10.937987814250505
      ],
      "text" : "typically one percent of full tank volume. As a variety of propellant systems"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        538.86036208748533,
        346.76365765151365,
        10.937987814250505
      ],
      "text" : "may be at play in an Artemis mission involving lunar landers, Orion, and the"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        526.86036258748538,
        344.20164629826405,
        10.937987814250505
      ],
      "text" : "Gateway Power and Propulsion Element, the ability to gauge both cryogenic"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        514.86036308748533,
        335.68943936293942,
        10.937987814250505
      ],
      "text" : "and earth-storable propellant with the same technology is also necessary."
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        495.36036389998543,
        345.53758347259992,
        10.937987814250505
      ],
      "text" : "Tank Health Monitoring (THM) is an active vibration based technology which"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        483.36036439998543,
        346.62742690718989,
        10.937987814250505
      ],
      "text" : "provides structural integrity information and fluid amount (mass) in tanks in"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        471.36036489998543,
        347.38328665569566,
        10.937987814250505
      ],
      "text" : "gravity and zero g environments. The fluid mass application is referred to as"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        459.36036539998543,
        327.37059210955812,
        10.937987814250505
      ],
      "text" : "Modal Propellant Gauge. The method is completely non-invasive, is fluid"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        447.36036589998542,
        300.35740994510752,
        10.937987814250505
      ],
      "text" : "independent and is highly accurate, providing near real time data."
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        427.86036671248542,
        340.2553574226929,
        10.937987814250505
      ],
      "text" : "The Modal Propellant Gauging (MPG) experiment seeks to raise TRL for the"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        415.86036721248541,
        340.2377793434253,
        10.937987814250505
      ],
      "text" : "gauging of settled and unsettled propellants from 6-7 by demonstrating an"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        403.86036771248541,
        318.42332699236084,
        10.937987814250505
      ],
      "text" : "end-to-end propellant mass gauging system that translates the modal"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        391.86036821248541,
        341.34080615746586,
        10.937987814250505
      ],
      "text" : "response of liquid-filled tanks in microgravity to liquid mass measurements"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        379.86036871248541,
        334.91600171516598,
        10.937987814250505
      ],
      "text" : "using a combination of sensor technology, data acquisition hardware, and"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        367.86036921248541,
        93.212398426149917,
        10.937987814250505
      ],
      "text" : "software algorithms."
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        348.36037002498546,
        312.13035832456791,
        10.937987814250505
      ],
      "text" : "The PZT Health monitoring system like the modal Propellant gauging"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        336.36037052498546,
        334.99510325187009,
        10.937987814250505
      ],
      "text" : "application uses a PZT actuator to supply a consistent random input while"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        324.36037102498545,
        343.7621928765746,
        10.937987814250505
      ],
      "text" : "recording PZT sensor responses on the tanks. The Graphs show the relative"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        312.36037152498545,
        356.44480991813236,
        10.937987814250505
      ],
      "text" : "frequencies transferred between two sensors with differences due to the tanks"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        300.36037202498545,
        313.6376825817627,
        10.937987814250505
      ],
      "text" : "stiffness changes which affect the frequencies and magnitudes of the"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        288.36037252498545,
        159.06005211249757,
        10.937987814250505
      ],
      "text" : "responses. (See Image: Equation)."
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        268.86037333748544,
        334.40184199658927,
        10.937987814250505
      ],
      "text" : "Where K is the material stiffness which is affected by the type, geometry,"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        256.86037383748544,
        337.86912686211912,
        10.937987814250505
      ],
      "text" : "temperature of the material and external stress such as pressure, M is the"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        244.86037433748544,
        122.76122536494873,
        10.937987814250477
      ],
      "text" : "modal mass of the system."
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        35.999998499999997,
        225.36037514998549,
        61.158688981721191,
        10.937987814250477
      ],
      "text" : "See Figure 1:"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        418.49998256250001,
        523.11036274373544,
        116.79784676342285,
        10.937987814250505
      ],
      "text" : "Accurate measurement of"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        418.49998256250001,
        511.11036324373543,
        119.25438964106684,
        10.937987814250448
      ],
      "text" : "cryogenic liquid propellant"
    },
    {
      "fontSize" : 8.9999996249999992,
      "monospaced" : false,
      "rect" : [
        418.49998256250001,
        499.11036374373543,
        114.48192896991941,
        10.937987814250505
      ],
      "text" : "quantity in space without"
    },
