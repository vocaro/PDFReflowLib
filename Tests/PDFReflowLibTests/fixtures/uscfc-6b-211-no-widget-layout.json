      "rect" : [
        71.996499999999997,
        176.09388000000001,
        465.04437200000029,
        13.416120000000006
      ],
      "text" : "_____________________________________________________________________________________________"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        71.996520000000032,
        164.57016000000002,
        468.05625599999973,
        13.416120000000006
      ],
      "text" : "NOTE – If the person served is neither a party nor a party’s officer and the place of travel is more than 100 miles (by"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        71.996520000000032,
        153.16596000000001,
        467.99450399999989,
        13.416120000000006
      ],
      "text" : "the shortest usual means of travel) from the place where the subpoena is served, or if the place of the hearing or trial"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        71.996520000000032,
        141.64224000000002,
        468.06820800000025,
        13.416120000000006
      ],
      "text" : "is more than 100 miles from the place where the person served resides, is employed, or transacts business in person,"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        71.996520000000032,
        130.11852000000002,
        467.96860800000024,
        13.416120000000006
      ],
      "text" : "the person served may file a motion to quash the subpoena pursuant to RCFC 45(d)(3) unless there is attached to the"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        71.996520000000032,
        118.59480000000001,
        468.10107600000003,
        13.416119999999992
      ],
      "text" : "subpoena an order of the court requiring his/her appearance notwithstanding the distance of travel. In any event,"
    },
    {
      "fontSize" : 9.9600000000000009,
      "monospaced" : false,
      "rect" : [
        72.00648000000001,
        107.07108000000001,
        429.19632000000001,
        13.416120000000006
      ],
      "text" : "response to the subpoena will entitle the person to the fees and mileage allowed by law. (28 U.S.C. § 1821)"
    }
